OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here
CHROMA_DB_PATH=./data/chroma_db

# Comma-separated origins allowed to call this API directly (browsers only;
# the Flutter app isn't subject to CORS). Add your deployed web client's URL
# here too once you deploy.
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173